function commonError(error) {    
    let errorMsg = "";
    if (error.status) {
        errorMsg = "Status: " + error.status + " - ";
    }

    if (error.responseJSON) {
        errorMsg = error.responseJSON.detail || "An error occurred.";
    }
    else if (error.responseText) {
        try {
            let jsonResponse = JSON.parse(error.responseText);
            errorMsg = jsonResponse.detail || "An error occurred.";
        } catch {
            errorMsg = error.responseText;
        }
    }
    else {
        errorMsg += "An unexpected error occurred.";
    }

    $("button[type='submit']").removeAttr('disabled');
    errorToastr(errorMsg);

    return errorMsg;
}


