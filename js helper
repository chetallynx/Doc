//#region API Call
// On Success Callback call the method which is pass as parameter
function callGetAPI(url, isAsync, successCallback, errorCallback) {
    try {
        var btn_html = null, btn = null;

        $.ajax({
            url: ApiUrl + url,
            async: isAsync,
            dataType: "json",
            headers: {
                'Authorization': 'Bearer ' + localStorage.getItem("token")
            },
            beforeSend: function () {
                if (event && event.submitter) {
                    btn = event.submitter;
                    btn_html = event.submitter.innerHTML;
                    $(btn).html('<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span> Loading');
                    $(btn).attr("disabled", "true");
                }
            },
            success: function (data) {
                if (successCallback != "") {
                    typeof (successCallback) === "function" ? successCallback(data) : window[successCallback](data);
                }
                else {
                    return data;
                }
            },
            error: function (error) {
                //$("button[type='submit']").html(btn_html)
                //$("button[type='submit']").removeAttr("disabled")
                if (error.status == 401) {
                    localStorage.removeItem("token");
                    location.href = "/Home/Index";
                    return;
                }
                window[errorCallback](error);
                if (btn != null) {
                    //$(btn).html(btn_html);
                    $(btn).removeAttr("disabled");
                }
            },
            complete: function () {
                if (btn != null) {
                    $(btn).html(btn_html);
                    $(btn).removeAttr("disabled");
                }
            }
        });
    }
    catch (ex) {
        if (btn != null) {
            $(btn).html(btn_html);
            $(btn).removeAttr("disabled");
        }
    }
}
function callPostAPI(url, data, isAsync, successCallback, errorCallback) {
    try {
        var btn_html = null, btn = null;
        $.ajax({
            url: ApiUrl + url,
            async: isAsync,
            method: "POST",
            contentType: 'application/json;charset=utf-8',
            data: JSON.stringify(data),
            headers: {
                'Authorization': 'Bearer ' + localStorage.getItem("token")
            },
            beforeSend: function () {
                if (event && event.submitter) {
                    btn = event.submitter;
                    btn_html = event.submitter.innerHTML;
                    $(btn).html('<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span> Loading');
                    $(btn).attr("disabled", "true");
                }
            },
            success: function (data) {
                try {
                    data = data ? data : [];
                    data = JSON.parse(data);
                } catch (e) { }

                if (successCallback != "") {
                    typeof (successCallback) === "function" ? successCallback(data) : window[successCallback](data);
                }
                else {
                    return data;
                }
            },
            error: function (error) {
                if (error.status == 401 && url != "authentication/login") {
                    localStorage.removeItem("token");
                    location.href = "/Home/Index";
                    return;
                }
                if (btn != null) {
                    $(btn).html(btn_html);
                    $(btn).removeAttr("disabled");
                }
                window[errorCallback](error);

            },
            complete: function () {
                if (btn != null) {
                    $(btn).html(btn_html);
                    $(btn).removeAttr("disabled");
                }
            }
        });
    }
    catch (ex) {
        if (btn != null) {
            $(btn).html(btn_html);
            $(btn).removeAttr("disabled");
        }
    }
}

