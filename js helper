//#region In-Memory (Object or JSON) Operation.

// Assign value to table.
function tblFill(json, table, tmplBody) {
    $(table + " tbody").empty();
    $(tmplBody).tmpl(json).appendTo(table + " tbody");
}

// Clear or reset form fields.
function resetInput(form) {
    $(form).each((index, input) => {
        if (input.type == "select-one")
            $(input).val($(input)[0].children[0].text).change();
        else input.value = null;
    });
}

// Convert form input or select fields to object.
function formToJSON(form, json) {
    $(form).each((index, field) => {
        if (field.type == "text")
            json[field.name] = field.value ? field.value : null;

        else if (field.type == "select-one") {
            json[field.name + "_Id"] = (isNaN(field.value) ? Boolean(field.value) : parseInt(field.value));
            json[field.name] = field.selectedOptions[0].text;
        }
        else
            json[field.name] = field.value ? field.value : null;
    });
}

// Add or update record to object & re-assign table.
function recordSave(json, form, table, tmplBody) {
    var id = form["id"].value;

    if (id > 0) {
        json.forEach((data) => {
            if (data.id == id) {
                formToJSON(form, data);
                data["operation"] = "update";
            }
        });
    }
    else {
        var row = {};
        var sr = Math.max.apply(Math, json.map(function (data) { return parseInt(data.sr); }));

        formToJSON(form, row);
        row["id"] = 0;
        row["sr"] = sr > 0 ? sr + 1 : 1;
        row["operation"] = "insert";

        json.push(row);
    }
    resetInput(form);
    tblFill(json, table, tmplBody)
}

// Fill record to input for update.
function recordEditClick(json, table, id) {
    json.forEach((data) => {
        if (data.id == id) {
            $(table + " thead td [name]").each((index, input) => {
                Object.keys(data).forEach(key => {
                    if (key == input.name) {
                        if (input.type == "text")
                            input.value = data[key];

                        else if (input.type == "select-one")
                            $(input).val(data[key + "Id"]).change();
                        else
                            alert(input);
                    }
                })
            });
        }
    });
}

// Delete record from object & table.
function recordDelete(json, table, id) {

    // Remove record from json
    const i = json.findIndex(element => element.id == id);
    json.splice(i, 1);

    // Remove record from table
    $(table + " tbody tr").each((index, tr) => {
        if (tr.children[0].innerText == id) {
            $(tr).addClass('bg-danger');
            $(tr).hide(500, function () {
                $(tr).remove();
            });
        }
    });
}

