function descriptiondropdownlength(dropdownId) {
    $(dropdownId).on('select2:selecting', function (e) {
        const selectedText = e.params.args.data.text;
        const currentValue = $(dropdownId).val().join(',');
        const totalLength = currentValue.length + selectedText.length + (currentValue ? 1 : 0);
        if (totalLength > 25) {
            e.preventDefault();
            errorToastr(MessageProvider.LENGTHMESSAGE);
        }
    });
}

$(document).on("click", ".password-addon", function () {
    let input = $(this).siblings("input");
    let icon = $(this).find("i");

    if (input.attr("type") === "password") {
        input.attr("type", "text");
        icon.removeClass("fi-rr-eye").addClass("fi-rr-eye-crossed"); // Change to eye-crossed
    } else {
        input.attr("type", "password");
        icon.removeClass("fi-rr-eye-crossed").addClass("fi-rr-eye"); // Change back to eye
    }
});
