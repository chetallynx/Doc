                $(".fileUploadProgress").css("width", "100%").css("background", "green").text("100%");
            },
            error: function (error) {
                if (error.status == 401) {
                    localStorage.removeItem("token");
                    location.href = "/Home/Index";
                    return;
                }
                $(".loader-container").hide();
                //$(".progress-loader").hide();
                $(".fileUploadProgress").css("width", "90%").css("background", "red").text("90% ");
                window[errorCallback](error);
            }
        });
    }
    catch (ex) {
    }
}

